{
  "name": "blog-website",
  "private": true,
  "scripts": {
    "start": "node scripts/local-static-server.mjs --port=8080",
    "start:8082": "node scripts/local-registration-server.mjs",
    "start:3000": "PORT=3000 node scripts/local-static-server.mjs --port=3000",
    "start:python": "python3 scripts/local-static-server.py --port 8080",
    "start:serve": "npx --yes serve . -l 8080",
    "speakers:merge": "node scripts/merge-speakers-html-parts.mjs",
    "speakers:parse": "node scripts/parse-speakers-html.mjs",
    "speakers:push": "node scripts/populate-airtable-speakers.mjs",
    "speakers:sync-tbs-firestore": "node scripts/sync-tbs-zermatt-speakers-to-firestore.mjs",
    "guests:sync-tbs-firestore": "node scripts/sync-tbs-zermatt-guests-to-firestore.mjs",
    "airtable:check": "node scripts/airtable-check.mjs",
    "content:sync-tbs": "node scripts/sync-contents-to-tbs-firestore.mjs",
    "content:rebuild-index": "node scripts/rebuild-tbs-content-row-index.mjs",
    "firebase:login": "firebase login",
    "firebase:prepare:hosting": "bash scripts/prepare-firebase-hosting.sh",
    "firebase:deploy:hosting": "bash scripts/prepare-firebase-hosting.sh && firebase deploy --only hosting --project tbs-app-e2062",
    "firebase:deploy:registration": "firebase deploy --only functions:submitRegistrationHttp --project tbs-app-e2062"
  },
  "devDependencies": {
    "firebase-tools": "^15.25.1"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0"
  }
}
